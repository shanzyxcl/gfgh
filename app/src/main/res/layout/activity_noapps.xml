<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="350dp"
    android:layout_height="250dp"
    android:background="@drawable/app1"
    android:layout_gravity="center"
    android:gravity="center"
    android:id="@+id/errorContainer"
    android:orientation="vertical">

    <ImageView
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:background="@drawable/ic_error"/>


    <TextView
        android:id="@+id/titleTextVieww"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠Error al Cargar el Anuncio️⚠"
        android:textStyle="bold"
        android:textSize="18sp"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:textColor="#FF3D3D"
        android:layout_gravity="center"
        android:gravity="center"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/messageTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1️⃣Verifique su conexión de Internet⚠️ 2️⃣Reinicie su celular⚠️ "
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:paddingBottom="16dp"/>
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center"
    android:orientation="horizontal">

    <Button
        android:id="@+id/exitButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/app4"
        android:textColor="#FFFFFF"
        android:layout_marginEnd="16dp"
        android:textSize="15sp"
        android:text="Salir"/>

    <Button
        android:id="@+id/retryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/app4"
        android:textColor="#FBFBFB"
        android:textSize="12sp"
        android:text="Reintentar"/>
</LinearLayout>

</LinearLayout>
